# ====================================
# Verse AI - Environment Configuration
# ====================================
#
# 🔑 GETTING YOUR API KEY:
# 1. Visit: https://platform.openai.com/api-keys
# 2. Sign up or log in to OpenAI
# 3. Click "Create new secret key"
# 4. Copy your key (starts with sk-)
# 5. Paste it below replacing 'your_openai_api_key_here'
#
# 📖 NEED HELP? See API_KEY_SETUP.md for detailed instructions
#
# ====================================

# REQUIRED: Your OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL: OpenAI API Base URL (change only if using a proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL: OpenAI Model Selection
# Options: gpt-3.5-turbo (fast/cheap), gpt-4 (smart/expensive)
OPENAI_MODEL=gpt-3.5-turbo

# Flask Configuration
SECRET_KEY=your_secret_key_here
DEBUG=True

# Optional: Customize assistant behavior
MAX_CONVERSATION_HISTORY=20
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=500
